PROJECT_NAME="AI Incident Response - Simulated Production App"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000"]
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Connection via asyncpg
DATABASE_URL="postgresql+asyncpg://postgres@localhost:5432/incident_response_db"

# Incident Simulation Configuration
SIMULATE_DB_TIMEOUT=False
SIMULATE_PAYMENT_FAILURE=False
SIMULATE_SLOW_API=False
SIMULATE_SLOW_API_LATENCY_MS=3000
SIMULATE_BACKGROUND_FAILURE=False
